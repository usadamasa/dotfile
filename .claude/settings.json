{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.claude/skills/triaging-brew-packages/scripts/brew-inventory.sh:*)",
      "Bash(shellcheck:*)",
      "Bash(editorconfig-checker:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-shell.sh\"",
            "statusMessage": "シェルスクリプトを静的解析中..."
          }
        ]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      ".claude/skills/triaging-brew-packages/scripts/brew-inventory.sh *"
    ]
  }
}
