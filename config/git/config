[user]
  name = usadamasa
  email = usadamasa@gmail.com
[include]
  # 端末ローカルの設定 (.gitignore 済み)。
  path = ~/.config/git/gitconfig.local
[color]
  ui = true
[pager]
  # diff-highlight は home-manager の git (home/packages.nix) の contrib にあり、PATH には載らない。
  # pager は sh -c で実行されるので変数が効く。.zshenv を経ない起動 (GUI から呼ばれる git) では
  # XDG_STATE_HOME が無いので既定値を添える。http.sslCAInfo はパス型で ~ しか展開されないため直書きのまま
  log = ${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/git/contrib/diff-highlight/diff-highlight | less
  show = ${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/git/contrib/diff-highlight/diff-highlight | less
  diff = ${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/share/git/contrib/diff-highlight/diff-highlight | less
[pull]
  rebase = true
  ff = only
[diff]
  tool = vimdiff
[core]
  excludesfile = ~/.config/git/ignore
  ignorecase = false
  quotepath = false
[ghq]
  root = ~/src
[http]
  # macOS の /etc/ssl/cert.pem は失効すべきルートを残すことがあるため、home-manager (home/packages.nix) の cacert を使う
  sslCAInfo = ~/.local/state/nix/profile/etc/ssl/certs/ca-bundle.crt
[merge]
  conflictStyle = diff3
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[alias]
  mc = !~/.config/git/git-mc
[fetch]
  prune = true
[init]
  defaultBranch = main
[wt]
  copyignored = true
  copyuntracked = true
  copymodified = true
  hook = test -f .envrc && direnv allow || true
  basedir = ../worktree/{gitroot}
  nocopy = .venv/
  nocopy = tmp/
  nocopy = .worktrees/
  nocopy = .databricks/
  nocopy = .pytest_cache/
  nocopy = .ruff_cache/
  nocopy = __pycache__/
  nocopy = node_modules/
[i18n]
  commitencoding = utf-8
  logoutputencoding = utf-8
